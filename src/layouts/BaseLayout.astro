---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = 'mehr alemi',
  description = 'mehr alemi',
  pageClass = '',
} = Astro.props;

const site = await getEntry('pages', 'site');
const siteTitle = site?.data.title || 'mehr alemi';
const menuYazilar = site?.data.menuYazilar || 'yazılar';
const menuHakkinda = site?.data.menuHakkinda || 'hakkında';

const fullTitle = title === 'mehr alemi' ? siteTitle : `${title} — ${siteTitle}`;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1e6d5" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Literata:opsz,wght@7..72,400;7..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={pageClass}>
    <div class="paper-noise" aria-hidden="true"></div>

    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">{siteTitle}</a>
        <span class="header-rule" aria-hidden="true"></span>
        <nav class="main-nav" aria-label="ana menü">
          <a href="/">{menuYazilar}</a>
          <a href="/hakkinda/">{menuHakkinda}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>{siteTitle}</span>
    </footer>

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </body>
</html>
