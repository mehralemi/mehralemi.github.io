---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readFile } from 'node:fs/promises';

const entries = (await getCollection('yazilar', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const stripMarkdown = (value: string) =>
  value
    .replace(/^---[\s\S]*?---\s*/m, '')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/[*_~]+/g, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const cropSummary = (value: string, max = 520) => {
  if (value.length <= max) return value;
  const cropped = value.slice(0, max);
  const lastSpace = cropped.lastIndexOf(' ');
  return `${cropped.slice(0, lastSpace > 360 ? lastSpace : max).trim()}…`;
};

const entriesWithSummary = await Promise.all(
  entries.map(async (entry) => {
    let fallback = '';

    if (!entry.data.excerpt?.trim()) {
      try {
        const raw = await readFile(
          new URL(`../data/yazilar/${entry.data.slug}.md`, import.meta.url),
          'utf8'
        );
        fallback = cropSummary(stripMarkdown(raw));
      } catch {
        fallback = '';
      }
    }

    return {
      entry,
      summary: entry.data.excerpt?.trim() || fallback,
    };
  })
);

const sceneClass = (index: number) => {
  const position = index % 4;
  if (position === 1) return 'scene-split is-reversed';
  if (position === 2) return 'scene-portrait';
  return 'scene-split';
};

const titleClass = (title: string) => {
  if (title.length >= 28) return 'title-long';
  if (title.length >= 20) return 'title-medium';
  return 'title-short';
};

const kindFor = (type: string) => type === 'şiir' ? 'poem' : 'prose';
---
<BaseLayout title="mehr alemi" pageClass="archive-page">
  <div class="archive-tools">
    <div class="filters" role="group" aria-label="yazı türleri">
      <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">
        hepsi
      </button>
      <button class="filter filter-poem" type="button" data-filter="poem" aria-pressed="false">
        şiir
      </button>
      <button class="filter filter-prose" type="button" data-filter="prose" aria-pressed="false">
        düz yazı
      </button>
    </div>
  </div>

  <section class="story-stream" aria-live="polite">
    {entriesWithSummary.map(({ entry, summary }, index) => (
      <article
        class={`story-scene ${sceneClass(index)}`}
        data-kind={kindFor(entry.data.type)}
        data-index={index}
      >
        <a class="scene-media" href={`/yazilar/${entry.id}/`} aria-label={entry.data.title}>
          <picture>
            {entry.data.mobileCover && (
              <source media="(max-width: 700px)" srcset={entry.data.mobileCover} />
            )}
            <img
              src={entry.data.cover}
              alt=""
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </a>

        <div class="scene-copy">
          <div class="scene-meta">
            <span class="type-tag">{entry.data.type}</span>
          </div>

          <h2 class={titleClass(entry.data.title)}>
            <a href={`/yazilar/${entry.id}/`}>{entry.data.title}</a>
          </h2>

          <p class="scene-summary">{summary}</p>

          <a class="read-link" href={`/yazilar/${entry.id}/`}>
            <span>metni oku</span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </section>

  <div class="load-more-wrap">
    <button class="load-more" type="button">daha fazlasını gör</button>
  </div>

  <script>
    const scenes = Array.from(document.querySelectorAll('.story-scene'));
    const filters = Array.from(document.querySelectorAll('.filter'));
    const loadMore = document.querySelector('.load-more');
    const archiveTools = document.querySelector('.archive-tools');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeFilter = 'all';
    let limit = 6;
    let revealObserver;
    let hasUserScrolled = false;
    let colorTicking = false;

    function matchesFilter(scene) {
      return activeFilter === 'all' || scene.dataset.kind === activeFilter;
    }

    function matchingScenes() {
      return scenes.filter(matchesFilter);
    }

    function visibleScenes() {
      return matchingScenes().filter((scene) => !scene.hidden);
    }

    function updateLoadMore() {
      if (!loadMore) return;
      loadMore.hidden = visibleScenes().length >= matchingScenes().length;
    }

    function setupRevealObserver() {
      revealObserver?.disconnect();

      const candidates = visibleScenes().filter(
        (scene) => !scene.classList.contains('is-revealed')
      );

      if (reduceMotion) {
        candidates.forEach((scene) => scene.classList.add('is-revealed'));
        return;
      }

      revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            revealObserver?.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -6% 0px',
        }
      );

      candidates.forEach((scene) => revealObserver.observe(scene));
    }

    function setImageColorProgress(scene, progress) {
      const img = scene.querySelector('.scene-media img');
      if (!img) return;

      const previous = Number(scene.dataset.colorProgress || 0);
      const next = Math.max(previous, Math.min(1, Math.max(0, progress)));
      scene.dataset.colorProgress = String(next);

      const gray = 1 - next;
      const saturation = 0.03 + (0.94 * next);
      const brightness = 0.965 + (0.035 * next);
      const contrast = 1.045 - (0.035 * next);

      img.style.setProperty('--gray', gray.toFixed(3));
      img.style.setProperty('--sat', saturation.toFixed(3));
      img.style.setProperty('--bright', brightness.toFixed(3));
      img.style.setProperty('--contrast', contrast.toFixed(3));
    }

    function resetImageColor(scene) {
      scene.dataset.colorProgress = '0';
      const img = scene.querySelector('.scene-media img');
      if (!img) return;
      img.style.setProperty('--gray', '1');
      img.style.setProperty('--sat', '.03');
      img.style.setProperty('--bright', '.965');
      img.style.setProperty('--contrast', '1.045');
    }

    function updateImageColorsFromScroll() {
      colorTicking = false;
      if (reduceMotion) return;

      const vh = window.innerHeight || document.documentElement.clientHeight;

      visibleScenes().forEach((scene) => {
        const media = scene.querySelector('.scene-media');
        if (!media) return;

        if (!hasUserScrolled) {
          resetImageColor(scene);
          return;
        }

        const rect = media.getBoundingClientRect();
        const center = rect.top + rect.height / 2;

        // Görsel ekranın alt %90 bandından orta %52 bandına ilerledikçe
        // siyah-beyazdan kendi rengine kademeli ve sürekli döner.
        const start = vh * 0.90;
        const end = vh * 0.52;
        const progress = (start - center) / (start - end);

        setImageColorProgress(scene, progress);
      });
    }

    function requestColorUpdate() {
      if (colorTicking) return;
      colorTicking = true;
      requestAnimationFrame(updateImageColorsFromScroll);
    }

    function renderFilter() {
      const matches = matchingScenes();
      limit = 6;

      scenes.forEach((scene) => {
        scene.hidden = true;
        scene.classList.remove('is-revealed');
        resetImageColor(scene);
      });

      matches.slice(0, limit).forEach((scene) => {
        scene.hidden = false;
      });

      updateLoadMore();
      setupRevealObserver();

      if (archiveTools) {
        const y = window.scrollY + archiveTools.getBoundingClientRect().top;
        window.scrollTo({
          top: Math.max(0, y),
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
      }
    }

    function restoreScrollY(y) {
      const root = document.documentElement;
      const body = document.body;
      const previousRootBehavior = root.style.scrollBehavior;
      const previousBodyBehavior = body.style.scrollBehavior;

      root.style.scrollBehavior = 'auto';
      body.style.scrollBehavior = 'auto';
      window.scrollTo(0, y);
      root.style.scrollBehavior = previousRootBehavior;
      body.style.scrollBehavior = previousBodyBehavior;
    }

    function showNextBatch() {
      const matches = matchingScenes();
      const currentCount = visibleScenes().length;
      const nextBatch = matches.slice(currentCount, currentCount + 6);

      if (!nextBatch.length) {
        updateLoadMore();
        return;
      }

      // Focus edilen buton aşağı taşındığında tarayıcı onu takip edip
      // sayfayı sona kaydırabiliyor. Önce odağı bırakıyoruz.
      loadMore?.blur();
      if (document.activeElement instanceof HTMLElement) {
        document.activeElement.blur();
      }

      const savedY = window.scrollY;

      nextBatch.forEach((scene) => {
        scene.hidden = false;
        scene.classList.remove('is-revealed');
        resetImageColor(scene);
      });

      limit = currentCount + nextBatch.length;
      updateLoadMore();
      setupRevealObserver();

      // İçerik açılırken görünüm kesinlikle bulunduğu yerde kalır.
      requestAnimationFrame(() => {
        if (Math.abs(window.scrollY - savedY) > 1) {
          restoreScrollY(savedY);
        }
        requestColorUpdate();
      });

      setTimeout(() => {
        if (Math.abs(window.scrollY - savedY) > 1) {
          restoreScrollY(savedY);
        }
      }, 80);
    }

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter || 'all';

        filters.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });

        renderFilter();
      });
    });

    loadMore?.addEventListener('mousedown', (event) => {
      // Butonun focus-scroll anchor olmasını baştan engelle.
      event.preventDefault();
    });

    loadMore?.addEventListener('click', showNextBatch);

    window.addEventListener(
      'scroll',
      () => {
        hasUserScrolled = true;
        requestColorUpdate();
      },
      { passive: true }
    );

    window.addEventListener('resize', requestColorUpdate);

    scenes.forEach((scene, index) => {
      scene.hidden = index >= limit;
      resetImageColor(scene);
    });

    updateLoadMore();
    setupRevealObserver();
  </script>
</BaseLayout>
