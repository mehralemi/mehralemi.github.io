---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readFile } from 'node:fs/promises';

const entries = (await getCollection('yazilar', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const stripMarkdown = (value: string) =>
  value
    .replace(/^---[\s\S]*?---\s*/m, '')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/[*_~]+/g, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const cropSummary = (value: string, max = 520) => {
  if (value.length <= max) return value;
  const cropped = value.slice(0, max);
  const lastSpace = cropped.lastIndexOf(' ');
  return `${cropped.slice(0, lastSpace > 360 ? lastSpace : max).trim()}…`;
};

const entriesWithSummary = await Promise.all(
  entries.map(async (entry) => {
    let fallback = '';

    if (!entry.data.excerpt?.trim()) {
      try {
        const raw = await readFile(
          new URL(`../data/yazilar/${entry.data.slug}.md`, import.meta.url),
          'utf8'
        );
        fallback = cropSummary(stripMarkdown(raw));
      } catch {
        fallback = '';
      }
    }

    return {
      entry,
      summary: entry.data.excerpt?.trim() || fallback,
    };
  })
);

/*
  Masaüstü ritmi:
  yatay-sol → portre-sağ → kare-sol → yatay-sağ → portre-sol → kare-sağ
  Mobilde nihai hizalar düzenlidir; sadece oran/genişlik çeşitlenir.
*/
const sceneClass = (index: number) => {
  const sequence = [
    'scene-landscape-left',
    'scene-portrait-right',
    'scene-square-left',
    'scene-landscape-right',
    'scene-portrait-left',
    'scene-square-right',
  ];

  return sequence[index % sequence.length];
};

const presentationClass = (index: number) => {
  const sequence = [
    'presentation-mat',
    'presentation-bare',
    'presentation-print',
    'presentation-line',
    'presentation-soft',
  ];

  return sequence[index % sequence.length];
};

const roomClass = (index: number) => {
  const room = Math.floor(index / 5) % 3;
  return ['room-stone', 'room-clay', 'room-sage'][room];
};

const titleClass = (title: string) => {
  if (title.length >= 28) return 'title-long';
  if (title.length >= 20) return 'title-medium';
  return 'title-short';
};

const kindFor = (type: string) => type === 'şiir' ? 'poem' : 'prose';
---
<BaseLayout title="mehr alemi" pageClass="archive-page">
  <div class="archive-tools">
    <div class="filters" role="group" aria-label="yazı türleri">
      <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">
        hepsi
      </button>
      <button class="filter filter-poem" type="button" data-filter="poem" aria-pressed="false">
        şiir
      </button>
      <button class="filter filter-prose" type="button" data-filter="prose" aria-pressed="false">
        düz yazı
      </button>
    </div>
  </div>

  <section class="story-stream" aria-live="polite">
    {entriesWithSummary.map(({ entry, summary }, index) => (
      <article
        class={`story-scene ${sceneClass(index)} ${presentationClass(index)} ${roomClass(index)}`}
        data-kind={kindFor(entry.data.type)}
        data-index={index}
      >
        <a class="scene-media" href={`/yazilar/${entry.id}/`} aria-label={entry.data.title}>
          <picture>
            {entry.data.mobileCover && (
              <source media="(max-width: 700px)" srcset={entry.data.mobileCover} />
            )}
            <img
              class="scroll-color-image"
              src={entry.data.cover}
              alt=""
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </a>

        <div class="scene-copy">
          <button
            class="type-tag gallery-label"
            type="button"
            data-type-filter={kindFor(entry.data.type)}
            aria-label={`${entry.data.type} yazılarını göster`}
          >
            {entry.data.type}
          </button>

          <h2 class={titleClass(entry.data.title)}>
            <a href={`/yazilar/${entry.id}/`}>{entry.data.title}</a>
          </h2>

          <p class="scene-summary">{summary}</p>

          <a class="read-link" href={`/yazilar/${entry.id}/`}>
            <span>metni aç</span>
            <span class="cta-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </section>

  <div class="load-more-wrap">
    <button class="load-more" type="button"><span>sonraki seçki</span><span aria-hidden="true">↓</span></button>
  </div>

  <script is:inline>
    (() => {
      const scenes = Array.from(document.querySelectorAll('.story-scene'));
      const topFilters = Array.from(document.querySelectorAll('.filter'));
      const typeTags = Array.from(document.querySelectorAll('[data-type-filter]'));
      const loadMore = document.querySelector('.load-more');
      const archiveTools = document.querySelector('.archive-tools');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const PAGE_SIZE = 5;
      let activeFilter = 'all';
      let visibleCount = PAGE_SIZE;
      let revealObserver = null;
      let scrollRaf = 0;
      let hasScrolled = false;

      const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

      function matches(scene) {
        return activeFilter === 'all' || scene.dataset.kind === activeFilter;
      }

      function matchingScenes() {
        return scenes.filter(matches);
      }

      function shownScenes() {
        return matchingScenes().filter((scene) => !scene.hidden);
      }

      function imageOf(scene) {
        return scene.querySelector('.scroll-color-image');
      }

      function setImageProgress(scene, progress) {
        const img = imageOf(scene);
        if (!img) return;

        const oldProgress = Number(scene.dataset.colorProgress || 0);
        const next = Math.max(oldProgress, clamp(progress, 0, 1));
        scene.dataset.colorProgress = String(next);

        const gray = 1 - next;
        const saturation = 0.02 + (0.98 * next);
        const contrast = 1.055 - (0.045 * next);
        const brightness = 0.93 + (0.07 * next);

        /*
          Inline !important kullanıyoruz:
          eski CSS kurallarının veya hover'ın filtreyi ezmesini teknik olarak engeller.
        */
        img.style.setProperty(
          'filter',
          `grayscale(${gray.toFixed(3)}) saturate(${saturation.toFixed(3)}) contrast(${contrast.toFixed(3)}) brightness(${brightness.toFixed(3)})`,
          'important'
        );
      }

      function resetImage(scene) {
        const img = imageOf(scene);
        if (!img) return;

        delete scene.dataset.colorStartScroll;
        scene.dataset.colorProgress = '0';

        img.style.setProperty(
          'filter',
          'grayscale(1) saturate(0) contrast(1.055) brightness(.93)',
          'important'
        );
      }

      function updateScrollColor() {
        scrollRaf = 0;
        if (!hasScrolled) return;

        const vh = window.innerHeight || document.documentElement.clientHeight;
        const travelNeeded = clamp(vh * 0.30, 210, 330);

        shownScenes().forEach((scene) => {
          const media = scene.querySelector('.scene-media');
          if (!media) return;

          const rect = media.getBoundingClientRect();

          if (rect.bottom < 0 || rect.top > vh) return;

          /*
            Görsel ekranın alt okuma bandına girdiği anda başlangıç noktası alınır.
            Sonraki 210–330px gerçek kullanıcı scroll mesafesinde siyah-beyazdan renge geçer.
          */
          if (
            scene.dataset.colorStartScroll === undefined &&
            rect.top <= vh * 0.88
          ) {
            scene.dataset.colorStartScroll = String(window.scrollY);
          }

          const start = Number(scene.dataset.colorStartScroll);
          if (!Number.isFinite(start)) return;

          const travelled = Math.max(0, window.scrollY - start);
          setImageProgress(scene, travelled / travelNeeded);
        });
      }

      function requestScrollColor() {
        if (scrollRaf) return;
        scrollRaf = requestAnimationFrame(updateScrollColor);
      }

      function setupRevealObserver() {
        if (revealObserver) revealObserver.disconnect();

        const candidates = shownScenes().filter(
          (scene) => !scene.classList.contains('is-revealed')
        );

        if (reduceMotion) {
          candidates.forEach((scene) => scene.classList.add('is-revealed'));
          shownScenes().forEach((scene) => setImageProgress(scene, 1));
          return;
        }

        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              revealObserver.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -5% 0px',
          }
        );

        candidates.forEach((scene) => revealObserver.observe(scene));
      }

      function updateFilterButtons() {
        topFilters.forEach((button) => {
          const active = button.dataset.filter === activeFilter;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });
      }

      function updateLoadMore() {
        if (!loadMore) return;
        loadMore.hidden = visibleCount >= matchingScenes().length;
      }

      function showCurrentSet({ resetReveal = false } = {}) {
        const matches = matchingScenes();

        scenes.forEach((scene) => {
          const shouldShow =
            matches.includes(scene) &&
            matches.indexOf(scene) < visibleCount;

          scene.hidden = !shouldShow;

          if (shouldShow && resetReveal) {
            scene.classList.remove('is-revealed');
            resetImage(scene);
          }
        });

        updateLoadMore();
        setupRevealObserver();
      }

      function applyFilter(filter, scrollToArchive = false) {
        activeFilter = filter;
        visibleCount = PAGE_SIZE;

        updateFilterButtons();
        showCurrentSet({ resetReveal: true });

        if (scrollToArchive && archiveTools) {
          const top =
            window.scrollY +
            archiveTools.getBoundingClientRect().top;

          window.scrollTo({
            top: Math.max(0, top),
            behavior: reduceMotion ? 'auto' : 'smooth',
          });
        }
      }

      function showMore(event) {
        event.preventDefault();

        if (loadMore) loadMore.blur();

        const matches = matchingScenes();
        const nextCount = Math.min(
          visibleCount + PAGE_SIZE,
          matches.length
        );

        if (nextCount === visibleCount) return;

        const savedY = window.scrollY;

        /*
          Chrome/Safari'nin buton odağı ve scroll anchoring yüzünden
          yeni içeriğin sonuna atlamasını engelliyoruz.
        */
        const root = document.documentElement;
        const body = document.body;
        const oldRootAnchor = root.style.overflowAnchor;
        const oldBodyAnchor = body.style.overflowAnchor;
        const oldBehavior = root.style.scrollBehavior;

        root.style.overflowAnchor = 'none';
        body.style.overflowAnchor = 'none';
        root.style.scrollBehavior = 'auto';

        const previouslyVisible = new Set(shownScenes());
        visibleCount = nextCount;

        const nowVisible = matchingScenes().slice(0, visibleCount);

        nowVisible.forEach((scene) => {
          scene.hidden = false;

          if (!previouslyVisible.has(scene)) {
            scene.classList.remove('is-revealed');
            resetImage(scene);
          }
        });

        updateLoadMore();

        const restore = () => window.scrollTo(0, savedY);
        restore();

        requestAnimationFrame(() => {
          restore();

          requestAnimationFrame(() => {
            restore();

            root.style.overflowAnchor = oldRootAnchor;
            body.style.overflowAnchor = oldBodyAnchor;
            root.style.scrollBehavior = oldBehavior;

            setupRevealObserver();
          });
        });
      }

      topFilters.forEach((button) => {
        button.addEventListener('click', () => {
          applyFilter(button.dataset.filter || 'all', false);
        });
      });

      /*
        İçerik üzerindeki tür etiketleri de artık gerçekten çalışır:
        etikete basınca o türe filtreler ve arşivin üstüne döner.
      */
      typeTags.forEach((tag) => {
        tag.addEventListener('click', () => {
          applyFilter(tag.dataset.typeFilter || 'all', true);
        });
      });

      if (loadMore) {
        loadMore.addEventListener('mousedown', (event) => {
          event.preventDefault();
        });

        loadMore.addEventListener('click', showMore);
      }

      window.addEventListener(
        'scroll',
        () => {
          hasScrolled = true;
          requestScrollColor();
        },
        { passive: true }
      );

      window.addEventListener('resize', requestScrollColor);

      /*
        İlk açılış: tam 5 içerik.
        Bütün görseller kesin olarak siyah-beyaz başlar.
      */
      scenes.forEach((scene, index) => {
        scene.hidden = index >= PAGE_SIZE;
        resetImage(scene);
      });

      updateFilterButtons();
      updateLoadMore();
      setupRevealObserver();
    })();
  </script>
</BaseLayout>
