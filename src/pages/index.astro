---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readFile } from 'node:fs/promises';

const entries = (await getCollection('yazilar', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const stripMarkdown = (value: string) =>
  value
    .replace(/^---[\s\S]*?---\s*/m, '')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/[*_~]+/g, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const cropSummary = (value: string, max = 520) => {
  if (value.length <= max) return value;
  const cropped = value.slice(0, max);
  const lastSpace = cropped.lastIndexOf(' ');
  return `${cropped.slice(0, lastSpace > 360 ? lastSpace : max).trim()}…`;
};

const entriesWithSummary = await Promise.all(
  entries.map(async (entry) => {
    let fallback = '';

    if (!entry.data.excerpt?.trim()) {
      try {
        const raw = await readFile(
          new URL(`../data/yazilar/${entry.data.slug}.md`, import.meta.url),
          'utf8'
        );
        fallback = cropSummary(stripMarkdown(raw));
      } catch {
        fallback = '';
      }
    }

    return {
      entry,
      summary: entry.data.excerpt?.trim() || fallback,
    };
  })
);

/*
  V19: aynı görsel kompozisyonu art arda kullanmıyoruz.
  6'lı ritim: yatay-sol → portre-sağ → kare-sol → yatay-sağ → portre-sol → kare-sağ.
*/
const sceneClass = (index: number) => {
  const sequence = [
    'scene-landscape-left',
    'scene-portrait-right',
    'scene-square-left',
    'scene-landscape-right',
    'scene-portrait-left',
    'scene-square-right',
  ];

  return sequence[index % sequence.length];
};

const titleClass = (title: string) => {
  if (title.length >= 28) return 'title-long';
  if (title.length >= 20) return 'title-medium';
  return 'title-short';
};

const kindFor = (type: string) => type === 'şiir' ? 'poem' : 'prose';
---
<BaseLayout title="mehr alemi" pageClass="archive-page">
  <div class="archive-tools">
    <div class="filters" role="group" aria-label="yazı türleri">
      <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">
        hepsi
      </button>
      <button class="filter filter-poem" type="button" data-filter="poem" aria-pressed="false">
        şiir
      </button>
      <button class="filter filter-prose" type="button" data-filter="prose" aria-pressed="false">
        düz yazı
      </button>
    </div>
  </div>

  <section class="story-stream" aria-live="polite">
    {entriesWithSummary.map(({ entry, summary }, index) => (
      <article
        class={`story-scene ${sceneClass(index)}`}
        data-kind={kindFor(entry.data.type)}
        data-index={index}
      >
        <a class="scene-media" href={`/yazilar/${entry.id}/`} aria-label={entry.data.title}>
          <picture>
            {entry.data.mobileCover && (
              <source media="(max-width: 700px)" srcset={entry.data.mobileCover} />
            )}
            <img
              class="scroll-color-image"
              src={entry.data.cover}
              alt=""
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </a>

        <div class="scene-copy">
          <div class="scene-meta">
            <span class="type-tag">{entry.data.type}</span>
          </div>

          <h2 class={titleClass(entry.data.title)}>
            <a href={`/yazilar/${entry.id}/`}>{entry.data.title}</a>
          </h2>

          <p class="scene-summary">{summary}</p>

          <a class="read-link" href={`/yazilar/${entry.id}/`}>
            <span>metni oku</span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </section>

  <div class="load-more-wrap">
    <button class="load-more" type="button">daha fazlasını gör</button>
  </div>

  <script>
    const scenes = Array.from(document.querySelectorAll('.story-scene'));
    const filters = Array.from(document.querySelectorAll('.filter'));
    const loadMore = document.querySelector('.load-more');
    const archiveTools = document.querySelector('.archive-tools');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeFilter = 'all';
    let limit = 6;
    let revealObserver;
    let scrollStarted = false;
    let colorFrame = 0;

    function matchesFilter(scene) {
      return activeFilter === 'all' || scene.dataset.kind === activeFilter;
    }

    function matchingScenes() {
      return scenes.filter(matchesFilter);
    }

    function visibleScenes() {
      return matchingScenes().filter((scene) => !scene.hidden);
    }

    function updateLoadMore() {
      if (!loadMore) return;
      loadMore.hidden = visibleScenes().length >= matchingScenes().length;
    }

    function getImage(scene) {
      return scene.querySelector('.scroll-color-image');
    }

    function resetColor(scene) {
      const img = getImage(scene);
      if (!img) return;

      delete scene.dataset.colorStartScroll;
      scene.dataset.colorProgress = '0';

      img.style.setProperty('--scroll-gray', '1');
      img.style.setProperty('--scroll-sat', '0');
      img.style.setProperty('--scroll-contrast', '1.055');
      img.style.setProperty('--scroll-bright', '.94');
    }

    function setColorProgress(scene, rawProgress) {
      const img = getImage(scene);
      if (!img) return;

      const previous = Number(scene.dataset.colorProgress || 0);
      const progress = Math.max(previous, Math.min(1, Math.max(0, rawProgress)));

      scene.dataset.colorProgress = String(progress);

      const gray = 1 - progress;
      const sat = 0.05 + (0.95 * progress);
      const contrast = 1.055 - (0.045 * progress);
      const bright = 0.94 + (0.06 * progress);

      img.style.setProperty('--scroll-gray', gray.toFixed(3));
      img.style.setProperty('--scroll-sat', sat.toFixed(3));
      img.style.setProperty('--scroll-contrast', contrast.toFixed(3));
      img.style.setProperty('--scroll-bright', bright.toFixed(3));
    }

    function updateColorsFromScroll() {
      colorFrame = 0;

      if (reduceMotion) {
        visibleScenes().forEach((scene) => setColorProgress(scene, 1));
        return;
      }

      if (!scrollStarted) return;

      const viewportHeight =
        window.innerHeight || document.documentElement.clientHeight;

      const colorDistance = Math.max(
        220,
        Math.min(360, viewportHeight * 0.34)
      );

      visibleScenes().forEach((scene) => {
        const media = scene.querySelector('.scene-media');
        if (!media) return;

        const rect = media.getBoundingClientRect();

        // Tamamen ekran dışındaysa hesaplama yapma.
        if (rect.bottom < 0 || rect.top > viewportHeight) return;

        // Görsel alt bölgeden görünmeye başladığı anda kendi scroll başlangıcını alır.
        // Böylece masaüstünde de mobildeki gibi scroll mesafesine bağlı renklenir.
        if (
          scene.dataset.colorStartScroll === undefined &&
          rect.top <= viewportHeight * 0.84
        ) {
          scene.dataset.colorStartScroll = String(window.scrollY);
        }

        const start = Number(scene.dataset.colorStartScroll);
        if (!Number.isFinite(start)) return;

        const travelled = Math.max(0, window.scrollY - start);
        setColorProgress(scene, travelled / colorDistance);
      });
    }

    function requestColorUpdate() {
      if (colorFrame) return;
      colorFrame = requestAnimationFrame(updateColorsFromScroll);
    }

    function setupRevealObserver() {
      revealObserver?.disconnect();

      const candidates = visibleScenes().filter(
        (scene) => !scene.classList.contains('is-revealed')
      );

      if (reduceMotion) {
        candidates.forEach((scene) => scene.classList.add('is-revealed'));
        visibleScenes().forEach((scene) => setColorProgress(scene, 1));
        return;
      }

      revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            revealObserver?.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -5% 0px',
        }
      );

      candidates.forEach((scene) => revealObserver.observe(scene));
    }

    function renderFilter() {
      const matches = matchingScenes();
      limit = 6;

      scenes.forEach((scene) => {
        scene.hidden = true;
        scene.classList.remove('is-revealed');
        resetColor(scene);
      });

      matches.slice(0, limit).forEach((scene) => {
        scene.hidden = false;
      });

      updateLoadMore();
      setupRevealObserver();

      if (archiveTools) {
        const y = window.scrollY + archiveTools.getBoundingClientRect().top;
        window.scrollTo({
          top: Math.max(0, y),
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
      }
    }

    function showNextBatch(event) {
      event?.preventDefault();
      loadMore?.blur();

      const matches = matchingScenes();
      const currentVisible = visibleScenes().length;
      const nextBatch = matches.slice(currentVisible, currentVisible + 6);

      if (!nextBatch.length) {
        updateLoadMore();
        return;
      }

      const savedY = window.scrollY;
      const root = document.documentElement;
      const previousBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';

      nextBatch.forEach((scene) => {
        resetColor(scene);
        scene.classList.remove('is-revealed');
        scene.hidden = false;
      });

      limit = currentVisible + nextBatch.length;
      updateLoadMore();

      // Mevcut konumu kesin koru; yeni içerikler aşağıda kendi
      // intersection animasyonlarıyla yüklenir.
      window.scrollTo(0, savedY);

      requestAnimationFrame(() => {
        window.scrollTo(0, savedY);

        requestAnimationFrame(() => {
          window.scrollTo(0, savedY);
          root.style.scrollBehavior = previousBehavior;
          setupRevealObserver();
          requestColorUpdate();
        });
      });
    }

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter || 'all';

        filters.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });

        renderFilter();
      });
    });

    loadMore?.addEventListener('click', showNextBatch);

    window.addEventListener(
      'scroll',
      () => {
        if (!scrollStarted && Math.abs(window.scrollY) > 8) {
          scrollStarted = true;
        }

        requestColorUpdate();
      },
      { passive: true }
    );

    window.addEventListener('resize', requestColorUpdate);

    // İlk görüntü: bütün görseller kesin siyah-beyaz.
    scenes.forEach((scene, index) => {
      scene.hidden = index >= limit;
      resetColor(scene);
    });

    updateLoadMore();
    setupRevealObserver();
  </script>
</BaseLayout>
